---
import { Phone, ArrowRight } from "@lucide/astro";
import type { Locale } from "../config/site";
import { site } from "../config/site";
import { useUI, r } from "../i18n/ui";

interface Props {
  locale: Locale;
  title?: string;
  text?: string;
  /** Which closing ask this page makes. Carries the register too: a producer
      page is formal and about buy-back, a residential one friendly and about
      a survey, so they are the same decision. Legal pages render no band. */
  variant?: keyof ReturnType<typeof useUI>["ctaVariants"];
}
const { locale, title, text, variant = "general" } = Astro.props;
const ui = useUI(locale);
const cta = ui.ctaVariants[variant];
const t = { ...ui, cta };
---

<!-- Dark CTA band – every page ends with one; no dead-end pages (§8) -->
<section class="bg-band">
  <div class="container-site section text-center">
    <h2 class="mx-auto max-w-2xl text-3xl font-bold text-white md:text-4xl">
      {title ?? t.cta.title}
    </h2>
    <p class="mx-auto mt-4 max-w-xl text-base text-white/70 md:text-lg">{text ?? t.cta.text}</p>
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href={r(locale, variant === "company" ? "kontakti" : "oferta")} class="btn btn-primary !px-8 !py-4 text-base">
        {t.cta.primary}
        <ArrowRight class="size-4" aria-hidden="true" />
      </a>
      <a href={`tel:${site.phoneHref}`} class="btn btn-ghost-band !px-8 !py-4 text-base">
        <Phone class="size-4" aria-hidden="true" />
        {site.phone}
      </a>
    </div>
  </div>
</section>
