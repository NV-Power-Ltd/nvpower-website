---
import type { Locale } from "../config/site";
import { useUI, r } from "../i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useUI(locale);
---

{/* Google Consent Mode v2 banner + settings panel (§3).

    Three outcomes, kept genuinely distinct so the middle one is not a
    relabelled "reject": accept all, reject all non-essential, or open the
    panel and pick per category. Layout follows the reference: the settings
    button spans the width, the two blunt choices sit side by side under it. */}
<div
  id="cc-banner"
  hidden
  class="fixed inset-x-3 bottom-20 z-60 mx-auto max-h-[calc(100dvh-7rem)] max-w-xl overflow-y-auto overscroll-contain rounded-2xl border border-line bg-surface p-5 shadow-[0_20px_60px_-15px_rgb(13_47_51/0.4)] md:bottom-5 md:max-h-[calc(100dvh-4rem)] md:p-6"
  role="dialog"
  aria-modal="false"
  aria-labelledby="cc-title"
>
  <h2 id="cc-title" class="font-[family-name:var(--font-display)] text-lg font-bold text-body">
    {t.consent.title}
  </h2>
  <p class="mt-2 text-sm leading-relaxed text-muted">
    {t.consent.text}{" "}
    <a href={r(locale, "privacy")} class="font-medium text-accent underline underline-offset-2">{t.consent.privacyLink}</a>.
  </p>

  {/* Per-category controls. Necessary is checked and disabled because it is
      not a choice; presenting it as one would be theatre. */}
  <div id="cc-settings" hidden class="mt-4 flex flex-col gap-2.5">
    <label class="flex items-start gap-3 rounded-xl bg-surface-alt p-3 text-sm">
      <input type="checkbox" checked disabled class="mt-0.5 size-4 accent-accent" />
      <span>
        <strong class="text-body">{t.consent.necessary}</strong><br />
        <span class="text-muted">{t.consent.necessaryText}</span>
      </span>
    </label>

    <label class="flex items-start gap-3 rounded-xl bg-surface-alt p-3 text-sm">
      <input id="cc-analytics" type="checkbox" class="mt-0.5 size-4 accent-accent" />
      <span>
        <strong class="text-body">{t.consent.analytics}</strong><br />
        <span class="text-muted">{t.consent.analyticsText}</span>
      </span>
    </label>

    <label class="flex items-start gap-3 rounded-xl bg-surface-alt p-3 text-sm">
      <input id="cc-marketing" type="checkbox" class="mt-0.5 size-4 accent-accent" />
      <span>
        <strong class="text-body">{t.consent.marketing}</strong><br />
        <span class="text-muted">{t.consent.marketingText}</span>
      </span>
    </label>

    <button id="cc-save" type="button" class="btn btn-primary mt-1 !py-2.5 text-sm">{t.consent.save}</button>
  </div>

  <div class="mt-4 flex flex-col gap-2">
    <button id="cc-toggle" type="button" class="btn btn-outline w-full !py-2.5 text-sm">
      {t.consent.settings}
    </button>
    <div class="grid grid-cols-2 gap-2">
      <button id="cc-reject" type="button" class="btn btn-outline !py-2.5 text-sm">{t.consent.rejectAll}</button>
      <button id="cc-accept" type="button" class="btn btn-primary !py-2.5 text-sm">{t.consent.acceptAll}</button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var KEY = "nvpower-consent";
    // The tag, the consent defaults and the saved choice are handled earlier,
    // in <head> (GoogleTag.astro). This script only drives the banner.
    function gtag() { (window.dataLayer = window.dataLayer || []).push(arguments); }
    var g = window.gtag || gtag;

    function apply(analytics, marketing) {
      g("consent", "update", {
        analytics_storage: analytics ? "granted" : "denied",
        ad_storage: marketing ? "granted" : "denied",
        ad_user_data: marketing ? "granted" : "denied",
        ad_personalization: marketing ? "granted" : "denied",
      });
    }

    var saved = null;
    try { saved = JSON.parse(localStorage.getItem(KEY) || "null"); } catch (e) {}
    // A choice saved before the marketing category existed is not a choice
    // about marketing, so ask again.
    var valid = !!saved && typeof saved.marketing === "boolean";

    var banner = document.getElementById("cc-banner");
    if (!banner) return;

    // Listeners are wired whether or not a choice exists, so the banner can be
    // reopened later. Withdrawing consent has to be as easy as giving it.
    banner.hidden = valid;

    var settings = document.getElementById("cc-settings");
    var toggle = document.getElementById("cc-toggle");
    var cbAnalytics = document.getElementById("cc-analytics");
    var cbMarketing = document.getElementById("cc-marketing");

    function decide(analytics, marketing) {
      try {
        localStorage.setItem(KEY, JSON.stringify({ analytics: analytics, marketing: marketing, ts: Date.now() }));
      } catch (e) {}
      apply(analytics, marketing);
      banner.hidden = true;
    }

    function openSettings() {
      var current = null;
      try { current = JSON.parse(localStorage.getItem(KEY) || "null"); } catch (e) {}
      cbAnalytics.checked = !!(current && current.analytics);
      cbMarketing.checked = !!(current && current.marketing);
      settings.hidden = false;
      toggle.hidden = true;
    }

    document.getElementById("cc-accept").addEventListener("click", function () { decide(true, true); });
    document.getElementById("cc-reject").addEventListener("click", function () { decide(false, false); });
    toggle.addEventListener("click", openSettings);
    document.getElementById("cc-save").addEventListener("click", function () {
      decide(cbAnalytics.checked, cbMarketing.checked);
    });

    // "Cookie settings" in the footer reopens the banner with the current
    // choice preselected, so it can be changed or revoked at any time.
    document.addEventListener("click", function (ev) {
      var trigger = ev.target && ev.target.closest && ev.target.closest("[data-cookie-settings]");
      if (!trigger) return;
      ev.preventDefault();
      openSettings();
      banner.hidden = false;
      banner.scrollIntoView({ block: "nearest" });
      document.getElementById("cc-save").focus();
    });
  })();
</script>
