---
import { ArrowRight, Zap, Sun, Factory, FileText, PenLine, Wrench, BadgeCheck, UserRound, Landmark, BatteryCharging, LifeBuoy, Flag, MapPin, Battery, PiggyBank } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import TrustBar from "../components/TrustBar.astro";
import CtaBand from "../components/CtaBand.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import MiniConfigurator from "../islands/MiniConfigurator";
import type { Locale } from "../config/site";
import { site, responseBadge, responseWithin } from "../config/site";
import { r } from "../i18n/ui";
import { featuredProjects, segmentLabels } from "../data/projects";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const c = {
  bg: {
    title: "NV Power, енергийни решения за бизнеса и производството",
    description:
      "Лицензиран търговец на електрическа енергия и координатор на стандартна балансираща група. Изкупуване на енергия от производители, доставка по индивидуална оферта и изграждане на фотоволтаични централи с батерии (BESS).",
    hero: {
      h1: "Енергийни решения за бизнеса и производството",
      /* Two sentences, rendered with <br /> inside one paragraph. The first
         states what the company is; the second, who it works with. */
      sub: [
        "NV Power е лицензиран търговец на електрическа енергия и координатор на стандартна балансираща група.",
        "Работим с производители на електроенергия, с големи консуматори и с инвеститори в соларни и BESS решения.",
      ],
      ctaPlans: "Виж направленията",
      ctaOffer: "Свържи се с нас",
    },
    lines: {
      eyebrow: "Направления",
      title: "Три направления с отделни условия",
      lead: "Всяко направление има собствен договор, собствени условия и собствен процес. Изборът по-долу води директно към съответните условия.",
      tok: {
        audience: "Производители",
        title: "Изкупуване и балансиране",
        badge: site.pricingBasisShort.bg,
        priceNote: "с възможност за включено балансиране",
        points: [
          "Формула спрямо БНЕБ (IBEX), записана в договора",
          "Балансирането се поема от нашата стандартна балансираща група",
          "Предизвестие от 1 месец при NV Фиксиран",
        ],
        cta: "Виж условията за изкупуване",
      },
      dostavka: {
        audience: "Потребители",
        title: "Доставка на електроенергия",
        badge: "по индивидуална оферта",
        priceNote: "за консуматори над 1 MW",
        points: [
          "Оферта, изготвена по товаровия профил на обекта",
          "Участие в стандартната ни балансираща група",
          "Без публикувана тарифа, условията се договарят",
        ],
        cta: "Виж условията за доставка",
      },
      solar: {
        audience: "Инвеститори",
        title: "Проектиране и реализация на ФЕЦ и BESS",
        badge: "до ключ, с финансиране",
        points: [
          "Проектиране, изграждане и въвеждане в експлоатация",
          "Фотоволтаични централи с батерии за съхранение (BESS)",
          "Лизинг и разсрочено плащане",
        ],
        cta: "Виж соларните решения",
      },
    },
    quiz: {
      eyebrow: "Мини конфигуратор",
      title: "Не знаеш откъде да започнеш?",
      lead: "Отговори на 3 кратки въпроса и ще ти покажем най-подходящото решение, за секунди, без данни за контакт.",
    },
    how: {
      eyebrow: "Как работи",
      title: "Три стъпки до по-добра енергия",
      steps: [
        { icon: FileText, title: "Изпращаш запитване", text: "Онлайн за 2 минути, или ни се обаждаш директно." },
        { icon: PenLine, title: `Получаваш оферта ${responseWithin.bg}`, text: "Конкретни числа за твоя обект, без ангажимент." },
        { icon: Wrench, title: "Договор онлайн / монтаж", text: "Смяната на доставчик е дистанционна; централата изграждаме до ключ." },
      ],
    },
    why: {
      eyebrow: "Защо NV Power",
      title: "Партньор, който мисли за твоята независимост",
      cards: [
        { icon: BadgeCheck, title: "Прозрачна формула", text: "Цената ти следва БНЕБ (IBEX) минус такса, записана в договора. Виждаш формулата, преди да подпишеш." },
        { icon: UserRound, title: "Личен консултант", text: "Един човек познава обекта ти и отговаря, по телефон, имейл или Viber." },
        { icon: Landmark, title: "Възможност за финансиране", text: "Лизинг и разсрочено плащане за соларни системи и батерии, започваш без голяма инвестиция." },
        { icon: BatteryCharging, title: "Батерии и собствено потребление", text: "Проектираме хибридни системи за по-високо собствено потребление и с възможност за резервно захранване на избрани вериги." },
        { icon: LifeBuoy, title: "Поддръжка и мониторинг", text: "Следим системата дистанционно и те уведомяваме, ако производството се отклони от очакваното." },
        { icon: Flag, title: "Българска компания", text: "Местен екип, местни решения и договори на разбираем български език." },
      ],
    },
    projects: {
      eyebrow: "Проекти",
      title: "Реални системи, реални икономии",
      /* Used while the list is empty: the heading above claims real results, so
         it must not sit over a "coming soon" line. */
      titleEmpty: "Проектите ще бъдат публикувани скоро",
      seeAll: "Виж всички проекти",
      specs: { power: "Мощност", battery: "Батерия", location: "Локация", savings: "Икономия" },
      empty: "Скоро публикуваме първите си реализирани проекти, с реални числа и снимки.",
    },
    faq: {
      /* The eyebrow is not "Въпроси" any more: it renders directly above the
         title, and "ВЪПРОСИ / Въпроси & Отговори" reads as a stutter. */
      eyebrow: "Накратко",
      title: "Въпроси & Отговори",
      more: "Виж всички въпроси и отговори",
      items: [
        { q: "Как се формира цената, по която изкупувате тока ми?", a: "По формулата на избрания план: борсовата цена на БНЕБ (IBEX) за съответния период минус договорената такса. Формулата е записана в договора и получаваш месечен отчет с пълна разбивка." },
        { q: "Плащам ли отделно за балансиране?", a: "Зависи от плана. При NV Фиксиран балансирането е включено в цената. При NV Standard има такса за балансиране, по-ниска при по-дългосрочен договор. И в двата случая влизаш в стандартната ни балансираща група, за която сме регистриран координатор към ЕСО." },
        { q: "Колко струва соларна система за дом?", a: "Ориентировъчните диапазони за типичните конфигурации са на страницата за дома. Срокът на възвръщаемост зависи от инвестицията, профила на потребление, собственото потребление на произведената енергия, цената на електроенергията и конфигурацията на батерията, затова го изчисляваме за конкретния обект. С нашето финансиране започваш без голяма първоначална инвестиция." },
        { q: "Какво прави батерията и трябва ли ми?", a: "Батерията съхранява произведената през деня енергия, за да я ползваш вечер, и така вдига дела на собственото потребление. Резервното захранване е отделна функция: при система, проектирана за целта, батерията може автоматично да поеме предварително определени товари при спиране на тока. Кое от двете тежи повече зависи от целта ти и от профила на потребление." },
        { q: "Какво е балансираща група?", a: "Група от търговски участници, за които един координатор носи отговорност за балансирането и уреждането на небалансите. Отклоненията на членовете взаимно се компенсират, така че общият небаланс е по-малък. В групата могат да участват и потребители, и производители, а включването е автоматично с договора." },
      ],
    },
  },
  en: {
    title: "NV Power, energy solutions for business and generation",
    description:
      "A licensed electricity trader and coordinator of a standard balancing group. Electricity offtake for generators, supply on an individual offer, and turnkey solar plants with battery storage (BESS).",
    hero: {
      h1: "Energy solutions for business and generation",
      sub: [
        "NV Power is a licensed electricity trader and a coordinator of a standard balancing group.",
        "We work with renewable generators, with large consumers, and with investors in solar and BESS.",
      ],
      ctaPlans: "See the three areas",
      ctaOffer: "Get in touch",
    },
    lines: {
      eyebrow: "Business areas",
      title: "Three areas, three separate sets of terms",
      lead: "Each area has its own contract, its own terms and its own process. The choice below leads straight to the relevant terms.",
      tok: {
        audience: "Producers",
        title: "Offtake and balancing services",
        badge: site.pricingBasisShort.en,
        priceNote: "balancing can be included",
        points: [
          "A formula against IBEX, written into the contract",
          "Balancing services provided through our standard balancing group",
          "One month's notice on NV Fixed",
        ],
        cta: "See the offtake terms",
      },
      dostavka: {
        audience: "Consumers",
        title: "Electricity supply",
        badge: "on an individual offer",
        priceNote: "for consumers above 1 MW",
        points: [
          "An offer built from the site's load profile",
          "Membership of our standard balancing group",
          "No published tariff, the terms are negotiated",
        ],
        cta: "See the supply terms",
      },
      solar: {
        audience: "Investors",
        title: "Solar PV and BESS, designed and built",
        badge: "turnkey, with financing",
        points: [
          "Design, construction and commissioning",
          "Solar plants with battery energy storage (BESS)",
          "Leasing and instalment plans",
        ],
        cta: "See the solar solutions",
      },
    },
    quiz: {
      eyebrow: "Mini configurator",
      title: "Not sure where to start?",
      lead: "Answer 3 short questions and we'll show you the best fit, in seconds, no contact details needed.",
    },
    how: {
      eyebrow: "How it works",
      title: "Three steps to better energy",
      steps: [
        { icon: FileText, title: "Send an enquiry", text: "Online in 2 minutes, or just call us." },
        { icon: PenLine, title: `Get a quote ${responseWithin.en}`, text: "Real numbers for your site, no commitment." },
        { icon: Wrench, title: "Contract online / installation", text: "Switching is handled remotely; plants are delivered on a turnkey EPC basis." },
      ],
    },
    why: {
      eyebrow: "Why NV Power",
      title: "A partner focused on your independence",
      cards: [
        { icon: BadgeCheck, title: "A transparent formula", text: "Your price follows IBEX minus a fee written into the contract. You see the formula before you sign." },
        { icon: UserRound, title: "Personal consultant", text: "One person knows your site and answers, by phone, email or Viber." },
        { icon: Landmark, title: "Financing available", text: "Leasing and instalments for solar systems and batteries, start without a big investment." },
        { icon: BatteryCharging, title: "Batteries & self-consumption", text: "We design hybrid systems for higher self-consumption, with the option of backup power for selected circuits." },
        { icon: LifeBuoy, title: "Support & monitoring", text: "We monitor the system remotely and let you know if production drifts from what we expect." },
        { icon: Flag, title: "A Bulgarian company", text: "A local team, local solutions and contracts in plain language." },
      ],
    },
    projects: {
      eyebrow: "Projects",
      title: "Real systems, real savings",
      titleEmpty: "Our projects will be published soon",
      seeAll: "See all projects",
      specs: { power: "Capacity", battery: "Battery", location: "Location", savings: "Savings" },
      empty: "We'll publish our first completed projects soon, with real numbers and photos.",
    },
    faq: {
      eyebrow: "In brief",
      title: "Questions & Answers",
      more: "See all questions & answers",
      items: [
        { q: "How is the price you buy my power at set?", a: "By your plan's formula: the IBEX day-ahead price for the period minus the agreed fee. The formula is written into the contract and you get a monthly statement with the full breakdown." },
        { q: "Do I pay separately for balancing?", a: "It depends on the plan. On NV Fixed, balancing is included in the price. On NV Standard there is a balancing fee, lower on a longer contract. Either way you join our standard balancing group, for which we are a registered coordinator with ESO." },
        { q: "How much does a home solar system cost?", a: "Indicative ranges for the typical configurations are on the residential page. The payback period depends on the investment, the consumption profile, how much of the generated energy is self-consumed, the price of electricity and the battery configuration, so we calculate it for the specific site. With our financing you start without a big upfront investment." },
        { q: "What does the battery do, do I need one?", a: "The battery stores the energy produced during the day so you can use it in the evening, which raises the share you consume yourself. Backup supply is a separate capability: in a system designed for it, the battery can automatically pick up pre-determined loads during an outage. Which of the two matters more depends on your goal and your consumption profile." },
        { q: "What is a balancing group?", a: "A group of market participants for whom a single coordinator carries responsibility for balancing and for settling imbalances. Members’ deviations offset each other, so the total imbalance is smaller. It can include both consumers and producers, and joining is automatic with your contract." },
      ],
    },
  },
}[locale];
---

<BaseLayout locale={locale} title={c.title} description={c.description} path="/">
  <!-- 1 ▸ HERO – full-width image with overlay, centered text -->
  <section class="relative -mt-16 flex min-h-[560px] items-center overflow-hidden md:-mt-20 md:min-h-[640px]">
    <div
      class="absolute inset-0 bg-cover bg-center"
      style="background-image: url('/images/hero.svg');"
      aria-hidden="true"
    ></div>
    <div class="absolute inset-0 bg-charcoal/45" aria-hidden="true"></div>

    <div class="container-site relative py-24 pt-40 text-center md:pt-44">
      <h1 class="mx-auto mt-4 max-w-3xl text-4xl font-bold text-white sm:text-5xl md:text-6xl md:leading-[1.08]">
        {c.hero.h1}
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-white/85 md:text-lg">
        {c.hero.sub.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </p>

      <!-- The hero deliberately does not compete with the three business CTAs
           below: its primary action is to send the visitor into the chooser. -->
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="#napravleniya" class="btn btn-primary !px-7 !py-4 text-base">
          {c.hero.ctaPlans}
          <ArrowRight class="size-4" aria-hidden="true" />
        </a>
        <a href={r(locale, "kontakti")} class="btn btn-ghost-band !px-7 !py-4 text-base">{c.hero.ctaOffer}</a>
      </div>

      {/* The regulatory status, from site.trust. Previously a row of sales
          promises; a licence number a producer can look up is worth more. */}
      <div class="mt-8">
        <TrustBar locale={locale} on="band" />
      </div>
    </div>
  </section>

  <!-- THREE BUSINESS AREAS – the audience chooser.
       Each card leads with what the *visitor* does ("Продавам ток"), not with
       what we do, so a producer, a buyer and an investor each recognise their
       own card at a glance. One CTA per card, three different destinations, so
       the calls to action never compete. -->
  <section id="napravleniya" class="section container-site scroll-mt-24">
    <SectionHeading eyebrow={c.lines.eyebrow} title={c.lines.title} lead={c.lines.lead} />

    <div class="mt-12 grid gap-6 lg:grid-cols-3">
      {
        [
          { d: c.lines.tok, icon: Zap, route: "tok" as const, primary: true },
          { d: c.lines.dostavka, icon: Factory, route: "dostavka" as const, primary: false },
          { d: c.lines.solar, icon: Sun, route: "solar" as const, primary: false },
        ].map(({ d, icon: Icon, route, primary }) => (
          <article class="card flex flex-col gap-4 p-7 md:p-8">
            <span class="flex size-12 items-center justify-center rounded-xl bg-accent/10 text-accent">
              <Icon class="size-6" aria-hidden="true" />
            </span>
            <p class="font-[family-name:var(--font-display)] text-sm font-bold tracking-wide text-accent uppercase">
              {d.audience}
            </p>
            <h3 class="text-xl font-bold text-body md:text-2xl">{d.title}</h3>
            <p>
              <span class="inline-flex rounded-full bg-accent/10 px-3.5 py-1.5 text-sm font-semibold text-accent">{d.badge}</span>
              {"priceNote" in d && d.priceNote && (
                <span class="mt-2 block text-sm font-medium text-muted">{d.priceNote}</span>
              )}
            </p>
            <ul class="list-disc space-y-2.5 pl-5 marker:text-accent">
              {d.points.map((p) => (
                <li class="text-[0.95rem] text-body">{p}</li>
              ))}
            </ul>
            <a
              href={r(locale, route)}
              class:list={["btn mt-auto self-start", primary ? "btn-primary" : "btn-outline"]}
            >
              {d.cta}
              <ArrowRight class="size-4" aria-hidden="true" />
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <!-- 4 ▸ MINI-CONFIGURATOR -->
  <section class="bg-surface-alt">
    <div class="container-site section">
      <SectionHeading eyebrow={c.quiz.eyebrow} title={c.quiz.title} lead={c.quiz.lead} />
      <div class="mt-10">
        <MiniConfigurator locale={locale} client:visible />
      </div>
    </div>
  </section>

  <!-- 5 ▸ HOW IT WORKS -->
  <section class="section container-site">
    <SectionHeading eyebrow={c.how.eyebrow} title={c.how.title} />
    <ol class="mt-12 grid gap-6 md:grid-cols-3">
      {c.how.steps.map((s, i) => (
        <li class="card relative p-7">
          <span class="absolute top-6 right-6 font-[family-name:var(--font-display)] text-5xl font-bold text-line">{String(i + 1).padStart(2, "0")}</span>
          <span class="flex size-12 items-center justify-center rounded-xl bg-accent/10 text-accent"><s.icon class="size-6" aria-hidden="true" /></span>
          <h3 class="mt-4 text-lg font-bold text-body">{s.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- 6 ▸ WHY NV POWER -->
  <section class="bg-surface-alt">
    <div class="container-site section">
      <SectionHeading eyebrow={c.why.eyebrow} title={c.why.title} />
      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {c.why.cards.map((card, i) => (
          <li class="card p-6">
            <span class="flex size-11 items-center justify-center rounded-xl bg-accent/10 text-accent"><card.icon class="size-5.5" aria-hidden="true" /></span>
            <h3 class="mt-3.5 font-[family-name:var(--font-display)] text-base font-bold text-body">{card.title}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-muted">{card.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 7 ▸ FEATURED PROJECTS -->
  <section class="section container-site">
    <SectionHeading
      eyebrow={c.projects.eyebrow}
      title={featuredProjects.length > 0 ? c.projects.title : c.projects.titleEmpty}
    />
    {featuredProjects.length === 0 ? (
      <p class="mx-auto mt-10 max-w-md text-center text-muted">{c.projects.empty}</p>
    ) : (
      <ul class="mt-12 grid gap-6 md:grid-cols-3">
        {featuredProjects.map((p, i) => (
          <li class="card overflow-hidden">
            <div class="flex h-36 items-center justify-center bg-linear-to-br from-[#00505c] to-[#007b88]">
              <Sun class="size-10 text-white/70" aria-hidden="true" />
            </div>
            <div class="p-6">
              <span class="inline-flex rounded-full bg-accent/10 px-3 py-1 text-xs font-bold text-accent">{segmentLabels[p.segment][locale]}</span>
              <h3 class="mt-3 font-[family-name:var(--font-display)] text-base font-bold text-body">{p.title[locale]}</h3>
              <dl class="mt-4 grid grid-cols-2 gap-x-3 gap-y-2.5 text-sm">
                <div class="flex items-center gap-2"><Zap class="size-4 text-accent" aria-hidden="true" /><dt class="sr-only">{c.projects.specs.power}</dt><dd class="font-semibold text-body">{p.kwp} kWp</dd></div>
                <div class="flex items-center gap-2"><Battery class="size-4 text-accent" aria-hidden="true" /><dt class="sr-only">{c.projects.specs.battery}</dt><dd class="font-semibold text-body">{p.batteryKwh ? `${p.batteryKwh} kWh` : "–"}</dd></div>
                <div class="flex items-center gap-2"><MapPin class="size-4 text-accent" aria-hidden="true" /><dt class="sr-only">{c.projects.specs.location}</dt><dd class="text-muted">{p.location[locale]}</dd></div>
                <div class="flex items-center gap-2"><PiggyBank class="size-4 text-accent" aria-hidden="true" /><dt class="sr-only">{c.projects.specs.savings}</dt><dd class="text-muted">{p.annualSavings[locale]}</dd></div>
              </dl>
            </div>
          </li>
        ))}
      </ul>
    )}
    {featuredProjects.length > 0 && (
      <div class="mt-9 text-center">
        <a href={r(locale, "proekti")} class="btn btn-outline">{c.projects.seeAll}<ArrowRight class="size-4" aria-hidden="true" /></a>
      </div>
    )}
  </section>

  <!-- FAQ TEASER -->
  <section class="section container-site">
    <SectionHeading eyebrow={c.faq.eyebrow} title={c.faq.title} />
    <div class="mx-auto mt-10 max-w-3xl">
      <FaqAccordion items={c.faq.items} />
      <p class="mt-6 text-center">
        <a href={r(locale, "info")} class="font-semibold text-accent underline decoration-2 underline-offset-4 hover:text-accent-hover">{c.faq.more}</a>
      </p>
    </div>
  </section>

  <!-- FINAL CTA BAND -->
  <CtaBand locale={locale} />
</BaseLayout>
