        { name: "БНЕБ", href: "https://www.ibex.bg", domain: "ibex.bg", why: "Актуалните борсови цени на тока, полезно, ако сте на борсов план или обмисляте такъв." },
        { name: "ЕСО", href: "https://www.eso.bg", domain: "eso.bg", why: "Данни за електроенергийната система в реално време, производство, потребление, обмени." },
        { name: "Електрохолд", href: "https://www.electrohold.bg", domain: "electrohold.bg", why: "Мрежовият оператор за Западна България, аварии, планови прекъсвания и самоотчет." },
        { name: "EVN България", href: "https://www.evn.bg", domain: "evn.bg", why: "Мрежовият оператор за Югоизточна България, аварии, прекъсвания и услуги по мрежата." },
        { name: "Енерго-Про", href: "https://www.energo-pro.bg", domain: "energo-pro.bg", why: "Мрежовият оператор за Североизточна България, аварии, прекъсвания и услуги по мрежата." },
        { name: "Министерство на енергетиката", href: "https://www.me.government.bg", domain: "me.government.bg", why: "Официална информация за енергийната политика, програмите за финансиране и нормативните промени." },
      ],
    },
  },
  en: {
    title: "Info centre, Q&A, glossary, documents | NV Power",
    description:
      "Answers on switching supplier, solar systems, batteries and financing, plus an energy glossary, documents and useful links.",
    hero: {
      eyebrow: "Info centre",
      h1: "Everything you want to know, in one place",
      sub: "Straight answers, a glossary of the jargon, our documents and useful links. If your answer isn't here, just ask us.",
    },
    tabsLabel: "Info centre sections",
    tabs: {
      faq: "Questions & answers",
      glossary: "Glossary",
      documents: "Documents",
      links: "Useful links",
    },
    faq: {
      filterLabel: "Filter questions by topic",
      categories: [
        { id: "all", label: "All" },
        { id: "switch", label: "Switching supplier" },
        { id: "solar", label: "Solar systems" },
        { id: "battery", label: "Batteries" },
        { id: "finance", label: "Financing" },
        { id: "invoice", label: "Invoices" },
      ],
      items: [
        {
          category: "switch",
          q: "How long does switching electricity supplier take?",
          a: "Usually about a month. We file the documents by the 10th of the current month and from the 1st of the next month you're buying your power from us. The whole procedure is administrative and we drive it, all you do is sign the contract. You don't even need to notify your old supplier, we do it for you.",
        },
        {
          category: "switch",
          q: "Will my power be interrupted during the switch?",
          a: "No, not for a second. The wires, the meter and the grid operator all stay the same, only the company issuing your invoice changes. From the grid's point of view, the switch is purely an accounting operation. If there were a technical interruption, nobody would ever switch supplier.",
        },
        {
          category: "switch",
          q: "What is a balancing group and what is an imbalance?",
          a: "Every market participant nominates in advance how much energy it will consume or generate, and the actual quantities always deviate from what was nominated. That difference is called an imbalance, and it has a price. A balancing group pools participants whose deviations offset each other, so the total imbalance is smaller, and a single coordinator is responsible for the balancing and for settling imbalances towards the system operator. With us, joining the group is automatic with your contract; whether the balancing cost is included in your price depends on the plan you choose.",
        },
        {
          category: "switch",
          q: "Do you require a deposit or a connection fee?",
          a: "No. We ask for no deposits, no connection fees and no one-off payments of any kind, switching is completely free. You pay only for the electricity you actually consume, at the agreed price. If another supplier asks you for a deposit, ask them why.",
        },
        {
          category: "switch",
          q: "Can I communicate with you via Viber or WhatsApp?",
          a: "Yes. Your personal consultant is reachable by phone, email, Viber and WhatsApp, you pick the channel that suits you. You can send invoices, photos of your roof or questions straight into the chat. We reply within the working day, and immediately on urgent matters.",
        },
        {
          category: "invoice",
          q: "How do I read my electricity invoice?",
          a: `The invoice has two main parts: energy, the kWh you consumed at the price agreed with your supplier, and network services (transmission and access), which are regulated by EWRC and identical with every supplier. ${site.regulatedComponents.en} Our invoice is one page with clear lines, and if anything is unclear, your consultant explains it line by line.`,
        },
        {
          category: "invoice",
          q: "What are the public obligations charge and excise duty on my invoice?",
          a: "The 'obligations to society' charge (ЗкО) is a regulated component that funds the purchase of green energy at preferential prices and other public obligations. It is set by EWRC in a decision for the relevant regulatory period and is identical with every supplier; the level changes between periods and can be zero. Excise duty is a state tax on electricity, at rates set by law that differ by type of consumption. Where they apply, neither stays with the supplier, we simply collect and remit them.",
        },
        {
          category: "solar",
          q: "Do I need a permit for a solar system?",
          a: "For certain installations up to 20 kW for self-consumption, on existing single-family homes and holiday houses, an eased regime without a construction permit may apply. The exact procedure depends on the type of site, how it connects and the intended mode of operation. We confirm which regime applies to the specific site before committing to anything. For larger systems the procedure is longer and involves an opinion from the grid operator. In both cases we handle the administration, from the application to commissioning.",
        },
        {
          category: "solar",
          q: "What's the difference between a hybrid and a grid-tied system?",
          a: "A grid-tied system works only together with the electricity grid, it produces while the sun shines, and in the evening you use grid power. A hybrid system adds a battery, it charges by day and powers you with your own energy in the evening. If it is also designed for backup supply, it can automatically pick up pre-determined loads when the grid is down. If your goal is maximum independence and outage protection, hybrid is the right choice. If you want the shortest payback, grid-tied often wins.",
        },
        {
          category: "solar",
          q: "How long does the installation take?",
          a: "The installation itself usually takes 2–4 working days for a home system, and one to several weeks for a larger business system depending on capacity. Most of a project's time goes into administration and coordination with the grid operator, not work on the roof. You get a realistic schedule with your quote, and we keep to it.",
        },
        {
          category: "solar",
          q: "Can I sell my surplus energy?",
          a: "Yes. The surplus your system produces and you don't consume can be sold, including to us, as a licensed trader. That requires a purchase agreement and the corresponding procedure with the grid operator. Keep in mind that as a rule self-consumption beats selling, because the price you save is usually higher than the price you sell at.",
        },
        {
          category: "solar",
          q: "How much does the system produce in winter?",
          a: "In the winter months production is around 15–20% of the annual total, the days are short and the sun sits low. That's normal and it's built into every honest payback calculation. That's why we size the system against your annual consumption profile, not against the best summer month. Snow usually slides off the panels by itself thanks to their tilt and smooth surface.",
        },
        {
          category: "solar",
          q: "What maintenance does a solar system need?",
          a: "Minimal. Panels have no moving parts and in most cases rain cleans them well enough, with visible dust build-up, one wash a year is plenty. Once a year it's good practice to inspect the connections and the inverter. We monitor your system remotely and let you know if anything drifts from normal.",
        },
        {
          category: "solar",
          q: "How do I track what my system produces?",
          a: "Every system we build comes with a free mobile monitoring app. You see real-time production, day-by-day and month-by-month history, your consumption and the battery status. We see the same data, so we spot deviations early and get in touch.",
        },
        {
          category: "solar",
          q: "What warranties do I get?",
          a: "The performance warranty on modules is typically 25 years, depending on the manufacturer and the model, and the manufacturer guarantees that even after that period the panel still delivers a defined percentage of its original output. Inverters carry a 5–10 year warranty depending on the manufacturer and model. On top of that, we warrant the installation work itself. All warranty terms are written into the contract, not into verbal promises.",
        },
        {
          category: "battery",
          q: "How long does a battery last?",
          a: "Modern LiFePO4 batteries are typically designed for 6,000+ charge–discharge cycles, depending on the model and the depth of discharge, which at one cycle a day is over 15 years of operation. After that the battery doesn't stop, it gradually loses capacity. LiFePO4 chemistry is also significantly safer and more durable than older lithium technologies.",
        },
        {
          category: "battery",
          q: "Will I have power if the grid goes down?",
          a: "Only if the system is designed for it. A battery on its own raises self-consumption but does not carry the site through a fault, that is a separate capability. In a system designed for backup supply, the battery can automatically pick up pre-determined loads when the grid supply fails. Four things are needed for that: an inverter with a backup output, automatic switching when the grid drops, an electrical design that takes the selected circuits to their own board, and a decision in advance about which loads go into it, say the fridge, lighting, internet and heating. How long they last depends on the battery capacity and what is connected. A grid-tied system without a battery shuts down during an outage for safety reasons.",
        },
        {
          category: "finance",
          q: "Who can apply for leasing and what does it cover?",
          a: "Both households and companies. The lease covers the entire system, panels, inverter, battery, mounting and installation, so you start without a large upfront investment. The application needs minimal paperwork and we assist through the whole procedure. The realised savings can offset part or all of the monthly instalment, depending on the specific project, and unlike an electricity bill the payment builds an asset you own.",
        },
        {
          category: "finance",
          q: "Can I pay in instalments without bank leasing?",
          a: "Yes, we also offer instalment schemes tied to the project stages, typically a part at contract, a part on equipment delivery and the balance at commissioning. For business clients we're flexible around cash flow. Your quote includes the specific options with numbers, so you can compare calmly.",
        },
      ],
    },
    glossary: {
      lead: "The energy sector is full of abbreviations. Here are the important ones, explained in plain language.",
      terms: [
        { t: "kWh (kilowatt-hour)", d: "A unit of energy: 1 kWh is the work of a 1-kilowatt appliance running for one hour. Everything on your electricity invoice is measured in kWh." },
        { t: "kWp (kilowatt peak)", d: "The maximum output of a solar system under standard test conditions. It's how the 'size' of a plant is described." },
        { t: "IBEX (БНЕБ)", d: "The Bulgarian Independent Energy Exchange, where wholesale electricity is traded. Exchange-indexed plans follow its prices." },
        { t: "EWRC (КЕВР)", d: "The Energy and Water Regulatory Commission, the state regulator that licenses traders and sets regulated prices and network charges." },
        { t: "DSO (ЕРП)", d: "The distribution system operator, the company maintaining the grid and meters in your region (Electrohold, EVN or Energo-Pro)." },
        { t: "ESO (ЕСО)", d: "The Electricity System Operator, it runs Bulgaria's transmission grid and balances the system in real time." },
        { t: "Inverter", d: "The device that converts the direct current from the panels into alternating current for your home and the grid. The 'brain' of every solar system." },
        { t: "Hybrid inverter", d: "An inverter that manages a battery in addition to the panels, routing energy to consumption, storage or the grid as needed. By itself it does not mean backup supply, which needs a model with a backup output and the electrical design to match." },
        { t: "Backup supply (EPS)", d: "A capability distinct from ordinary battery operation. In a system designed for backup supply, the battery can automatically pick up pre-determined loads when the grid supply fails. It depends on the inverter architecture, on automatic switching, on the electrical design and on which loads are selected for the backup board." },
        { t: "Grid-tied system (on-grid)", d: "A solar system connected to the electricity grid, without a battery. The simplest solution with the shortest payback." },
        { t: "Off-grid system", d: "A system independent of the grid, all energy comes from the panels and batteries. Used for remote sites with no grid access." },
        { t: "BESS", d: "Battery Energy Storage System, from home batteries to industrial containerised solutions." },
        { t: "LiFePO4", d: "Lithium iron phosphate battery chemistry, the standard for home and business batteries thanks to its safety and long cycle life. The actual number of cycles depends on the model and how it is operated." },
        { t: "Balancing group", d: "A group of market participants for whom a single coordinator carries responsibility for balancing and for settling imbalances. It can include both consumers and producers, and their deviations offset each other." },
        { t: "Balancing group coordinator", d: "The participant responsible for the forecasts, the balancing and the settlement of the group members’ imbalances towards the electricity system operator." },
        { t: "Balancing", d: "Evening out the difference between nominated and actual quantities of energy. The balancing cost is carried by the group coordinator and settled under the contract." },
        { t: "Imbalance", d: "The difference between the nominated or forecast quantities and the quantities actually metered for the relevant settlement period. It has a price someone pays, which is why whose balancing group you are in matters." },
        { t: "Public obligations charge (ЗкО)", d: "'Obligations to society', a regulated component of the electricity price that funds green energy at preferential prices and other public obligations. It is set by EWRC for the relevant regulatory period and its level can change." },
        { t: "Excise duty", d: "A state tax on electricity that the supplier collects and remits to the budget. Identical with every supplier." },
        { t: "Monocrystalline panel", d: "A panel made of monocrystalline silicon, today's standard, with the highest efficiency and the best low-light performance." },
        { t: "String", d: "A group of panels connected in series to one inverter input. Correct string sizing is a key part of the design." },
        { t: "EV charger", d: "A charging station for an electric vehicle. Combined with a solar system, you charge your car with your own energy." },
        { t: "Self-consumption", d: "The share of produced energy you consume directly instead of feeding into the grid. The higher it is, the faster the payback." },
        { t: "PPA", d: "Power Purchase Agreement, a long-term contract to buy energy at a pre-agreed price, often used with commercial plants." },
      ],
    },
    documents: {
      lead: "Licence and terms, public and accessible, the way it should be.",
    },
    links: {
      lead: "The official sources worth keeping at hand.",
      items: [
        { name: "EWRC (КЕВР)", href: "https://www.dker.bg", domain: "dker.bg", why: "Verify any trader's licence and see the regulated prices and the regulator's decisions." },
        { name: "IBEX (БНЕБ)", href: "https://www.ibex.bg", domain: "ibex.bg", why: "The current exchange prices for electricity, useful if you're on an exchange plan or considering one." },
        { name: "ESO (ЕСО)", href: "https://www.eso.bg", domain: "eso.bg", why: "Real-time data on the power system, generation, consumption, cross-border exchange." },
        { name: "Electrohold", href: "https://www.electrohold.bg", domain: "electrohold.bg", why: "The grid operator for Western Bulgaria, outages, planned interruptions and self-readings." },
        { name: "EVN Bulgaria", href: "https://www.evn.bg", domain: "evn.bg", why: "The grid operator for South-East Bulgaria, outages, interruptions and network services." },
        { name: "Energo-Pro", href: "https://www.energo-pro.bg", domain: "energo-pro.bg", why: "The grid operator for North-East Bulgaria, outages, interruptions and network services." },
        { name: "Ministry of Energy", href: "https://www.me.government.bg", domain: "me.government.bg", why: "Official information on energy policy, financing programmes and regulatory changes." },
      ],
    },
  },
}[locale];

const tabs = [
  { id: "faq", label: c.tabs.faq, icon: MessagesSquare },
  { id: "glossary", label: c.tabs.glossary, icon: BookOpen },
  { id: "documents", label: c.tabs.documents, icon: FileText },
  { id: "links", label: c.tabs.links, icon: ExternalLink },
] as const;

/** FAQPage JSON-LD from the first 10 FAQ items */
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: c.faq.items.slice(0, 10).map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<BaseLayout locale={locale} title={c.title} description={c.description} path="/info/" jsonLd={[faqLd]}>
  <!-- 1 ▸ HERO (light) -->
  <section class="border-b border-line bg-surface-alt">
    <div class="container-site pt-12 pb-12 text-center md:pt-16">
      <h1 class="mx-auto mt-3 max-w-3xl text-3xl font-bold text-body md:text-5xl">{c.hero.h1}</h1>
      <p class="mx-auto mt-4 max-w-2xl text-muted md:text-lg">{c.hero.sub}</p>
    </div>
  </section>

  <!-- 2 ▸ TABS -->
  <section id="info-tabs" class="section container-site">
    <div class="flex flex-wrap items-center justify-center gap-2" role="tablist" aria-label={c.tabsLabel}>
      {
        tabs.map((tab, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${tab.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            aria-controls={`panel-${tab.id}`}
            tabindex={i === 0 ? 0 : -1}
            class="inline-flex items-center gap-2 rounded-full border border-line px-5 py-2.5 font-[family-name:var(--font-display)] text-sm font-semibold text-body transition-colors hover:border-accent aria-selected:border-accent aria-selected:bg-accent aria-selected:text-accent-contrast"
          >
            <tab.icon class="size-4" aria-hidden="true" />
            {tab.label}
          </button>
        ))
      }
    </div>

    <!-- 2a ▸ FAQ panel -->
    <div id="panel-faq" role="tabpanel" aria-labelledby="tab-faq" tabindex="0" class="mt-10">
      <div class="flex flex-wrap items-center justify-center gap-2" role="group" aria-label={c.faq.filterLabel}>
        {
          c.faq.categories.map((cat) => (
            <button
              type="button"
              data-faq-filter={cat.id}
              aria-pressed={cat.id === "all" ? "true" : "false"}
              class="rounded-full border border-line px-4 py-2 text-xs font-semibold text-muted transition-colors hover:border-accent aria-pressed:border-accent aria-pressed:bg-accent/10 aria-pressed:text-accent"
            >
              {cat.label}
            </button>
          ))
        }
      </div>
      <div class="mx-auto mt-8 max-w-3xl">
        <FaqAccordion items={c.faq.items} />
      </div>
    </div>

    <!-- 2b ▸ Glossary panel -->
    <div id="panel-glossary" role="tabpanel" aria-labelledby="tab-glossary" tabindex="0" hidden class="mt-10">
      <p class="mx-auto max-w-2xl text-center text-muted">{c.glossary.lead}</p>
      <dl class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          c.glossary.terms.map((term) => (
            <div class="card p-5">
              <dt class="font-[family-name:var(--font-display)] text-[0.95rem] font-bold text-body">{term.t}</dt>
              <dd class="mt-1.5 text-sm leading-relaxed text-muted">{term.d}</dd>
            </div>
          ))
        }
      </dl>
    </div>

    <!-- 2c ▸ Documents panel -->
    <div id="panel-documents" role="tabpanel" aria-labelledby="tab-documents" tabindex="0" hidden class="mt-10">
      <p class="mx-auto max-w-2xl text-center text-muted">{c.documents.lead}</p>
      <div class="mx-auto mt-8 max-w-3xl">
        <DocumentsList locale={locale} />
      </div>
    </div>

    <!-- 2d ▸ Links panel -->
    <div id="panel-links" role="tabpanel" aria-labelledby="tab-links" tabindex="0" hidden class="mt-10">
      <p class="mx-auto max-w-2xl text-center text-muted">{c.links.lead}</p>
      <ul class="mx-auto mt-8 grid max-w-4xl gap-4 sm:grid-cols-2">
        {
          c.links.items.map((link) => (
            <li class="card p-5">
              <a href={link.href} target="_blank" rel="noopener" class="group flex items-start gap-3.5">
                <span class="flex size-10 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent">
                  <ExternalLink class="size-5" aria-hidden="true" />
                </span>
                <span>
                  <span class="block font-[family-name:var(--font-display)] text-[0.95rem] font-bold text-body transition-colors group-hover:text-accent">
                    {link.name}
                  </span>
                  <span class="mt-1 block text-sm leading-relaxed text-muted">{link.why}</span>
                  <span class="mt-1.5 block text-xs font-semibold text-accent">{link.domain} ↗</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- 3 ▸ FINAL CTA BAND -->
  <CtaBand locale={locale} tone="formal" />

  <script>
    // ---- Tabs (aria-selected + hidden panels, arrow-key navigation) ----
    const tablist = document.querySelector<HTMLElement>('#info-tabs [role="tablist"]')!;
    const tabBtns = Array.from(tablist.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = tabBtns.map((t) => document.getElementById(t.getAttribute("aria-controls")!));

    function selectTab(tab: HTMLButtonElement) {
      tabBtns.forEach((t, i) => {
        const selected = t === tab;
        t.setAttribute("aria-selected", String(selected));
        t.tabIndex = selected ? 0 : -1;
        panels[i]?.toggleAttribute("hidden", !selected);
      });
    }

    tabBtns.forEach((tab, i) => {
      tab.addEventListener("click", () => selectTab(tab));
      tab.addEventListener("keydown", (e) => {
        let next: number | null = null;
        if (e.key === "ArrowRight") next = (i + 1) % tabBtns.length;
        if (e.key === "ArrowLeft") next = (i - 1 + tabBtns.length) % tabBtns.length;
        if (e.key === "Home") next = 0;
        if (e.key === "End") next = tabBtns.length - 1;
        if (next !== null) {
          e.preventDefault();
          selectTab(tabBtns[next]);
          tabBtns[next].focus();
        }
      });
    });

    // ---- FAQ category filter ----
    const filterBtns = document.querySelectorAll<HTMLButtonElement>("[data-faq-filter]");
    const faqItems = document.querySelectorAll<HTMLElement>("#panel-faq details[data-category]");

    filterBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        const cat = btn.dataset.faqFilter;
        filterBtns.forEach((b) => b.setAttribute("aria-pressed", String(b === btn)));
        faqItems.forEach((d) => {
          d.classList.toggle("hidden", cat !== "all" && d.dataset.category !== cat);
        });
      });
    });
  </script>
</BaseLayout>
