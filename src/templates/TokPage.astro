---
import { ArrowRight, Check, Zap, LineChart, Building2, FileSearch, PenLine, Repeat, Clock, BadgePercent, ShieldCheck } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHeading from "../components/SectionHeading.astro";
import CtaBand from "../components/CtaBand.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import InvoiceUpload from "../islands/InvoiceUpload";
import type { Locale } from "../config/site";
import { site, SITE_URL, CAN_ACCEPT_UPLOADS, responseBadge, responseWithin } from "../config/site";
import { r } from "../i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;


/* Service schema: what this page's area actually is, for crawlers and models.
   No Offer and no price, because the price is a formula, not a number. */
const serviceLd = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: locale === "bg" ? "Изкупуване на електрическа енергия от производители" : "Electricity offtake from generators",
  serviceType: "Electricity purchase agreement",
  description: locale === "bg" ? "Изкупуване на произведената електроенергия по цена, обвързана с борсовия пазар „Ден напред“ на БНЕБ, минус договорен търговски компонент. NV Power е координатор на стандартна балансираща група и поема балансирането." : "Purchase of generated electricity at a price linked to the IBEX day-ahead market, minus an agreed trading component. NV Power is a standard balancing group coordinator and takes on the balancing.",
  url: `${SITE_URL}${r(locale, "tok")}`,
  provider: { "@type": "Organization", name: site.name, url: SITE_URL },
  areaServed: { "@type": "Country", name: locale === "bg" ? "България" : "Bulgaria" },
  audience: { "@type": "Audience", audienceType: locale === "bg" ? "Производители на електроенергия от възобновяеми източници" : "Renewable electricity producers" },
};
const c = {
  bg: {
    title: "Изкупуване на електроенергия от производители | NV Power",
    description: `Продавайте тока си при ясни условия: NV Фиксиран (БНЕБ − 15 €/MWh), NV Standard или индивидуална оферта над 1 MW. Балансирането е включено при NV Фиксиран.`,
    hero: {
      h1: "Продавайте тока си. При ясни условия.",
      sub: "Лицензиран търговец на електроенергия. Изкупуваме продукцията на производители на електроенергия, с прозрачна формула и включено балансиране при NV Фиксиран.",
      ctaPrimary: "Вземете оферта",
      ctaSecondary: "Вижте плановете",
      checks: [responseBadge.bg, "Включено балансиране при NV Фиксиран", "Без депозити"],
    },
    plans: {
      eyebrow: "Планове",
      title: "Изберете как да продавате произведената енергия",
      lead: "Три плана с ясна цена и договор, с постоянна комуникация с екипа ни през целия период.",
      note: "с възможност за включено балансиране",
      noticeLabel: "Предизвестие",
      items: [
        {
          icon: Zap,
          name: "NV Фиксиран",
          /* The name says „фиксиран"; only the component is. The qualifier rides
             on the name so a scanner cannot miss it. */
          nameNote: "фиксиран е търговският компонент, не цената на енергията",
          mechanism:
            "Изкупна цена: БНЕБ, пазар „Ден напред“, минус фиксиран търговски компонент от 15 €/MWh. Фиксиран е компонентът, не цената на енергията.",
          priceMain: "БНЕБ − 15 €/MWh",
          priceSub: site.market.bg,
          term: "предизвестие само 1 месец",
          features: [
            "Предизвестие: само 1 месец, без дългосрочно обвързване",
            "Фиксирано балансиране",
            "Постоянна комуникация и поддръжка от търговския ни екип",
            "Идеален за малки и средни ВЕИ производители",
          ],
          cta: "Вземете оферта за NV Фиксиран",
        },
        {
          icon: LineChart,
          badge: "Най-популярен",
          name: "NV Standard",
          nameNote: "борсова цена, с по-нисък компонент при по-дълго предизвестие",
          mechanism:
            "Изкупна цена: БНЕБ, пазар „Ден напред“, минус търговски компонент от 3 или 2 €/MWh според избраната опция.",
          term: "две нива на гъвкавост",
          /* Two-component plan – the visitor picks a tier inside the card. */
          options: [
            {
              id: "flex",
              label: "Standard Flexible",
              formula: "БНЕБ − 3 €/MWh",
              notice: "1 месец",
              hint: "По-кратък срок, повече свобода",
            },
            {
              id: "long",
              label: "Standard Дългосрочен",
              formula: "БНЕБ − 2 €/MWh",
              notice: "6 месеца",
              hint: "Най-добрата цена за стандартен план",
            },
          ],
          features: [
            "Избирате нивото на гъвкавост според планирания хоризонт",
            "По-ниска такса за балансиране при по-дългосрочен договор",
            "Включено пълно управление на балансиращата група",
          ],
          cta: "Изберете NV Standard",
        },
        {
          icon: Building2,
          badge: "За големи обекти (над 1 MW)",
          name: "NV Individual",
          nameNote: "договорени условия по производствения профил на обекта",
          mechanism:
            "Изкупна цена: по договаряне, спрямо производствения профил на централата и периода на договора.",
          priceMain: "По договаряне",
          priceSub: "спрямо производствения профил на централата",
          term: "предизвестие по договор",
          features: [
            "Персонализирана оферта за производители с мощност над 1 MW",
            "Предизвестие: индивидуално спрямо договора",
            "Анализ на производствения профил преди офертата",
            "Личен акаунт мениджър и индивидуална търговска стратегия",
          ],
          cta: "Заявете индивидуална оферта",
        },
      ],
      /* Producers only. Supply for large consumers has its own page, so this
         one never mixes buyer and seller language. */
      b2b: {
        badge: "За централи над 1 MW",
        title: "Индивидуална оферта за големи централи",
        text: "За производители с мощност над 1 MW изготвяме персонализирани условия за изкупуване, на база специфичния профил на производство.",
        cta: "Заявете индивидуална оферта",
        supplyNote: "Търсите доставка на електроенергия за свой обект, а не изкупуване?",
        supplyCta: "Вижте доставката",
      },
    },
    compare: {
      eyebrow: "Сравнение",
      title: "Плановете един до друг",
      methodology: site.pricingMethodology.bg,
      lead: `Референтен пазар: ${site.marketFull.bg}. Всички търговски компоненти са в €/MWh. Без звездички и дребен шрифт: това са условията.`,
      cols: ["План", "Формула", "Срок на предизвестие", "Целева група", "Основно предимство"],
      rows: [
        { plan: "NV Фиксиран", formula: "БНЕБ − 15 €/MWh", notice: "1 месец", target: "Малки ВЕИ централи", advantage: "Пълна свобода с 1 месец предизвестие." },
        { plan: "NV Standard Flexible", formula: "БНЕБ − 3 €/MWh", notice: "1 месец", target: "Средни ВЕИ", advantage: "Баланс между добра цена и кратък срок." },
        { plan: "NV Standard Дългосрочен", formula: "БНЕБ − 2 €/MWh", notice: "6 месеца", target: "Стабилни ВЕИ", advantage: "Максимална печалба с най-ниска такса за балансиране." },
        { plan: "NV Individual", formula: "По договаряне", notice: "По договаряне", target: "Обекти над 1 MW", advantage: "Условия, построени спрямо профила на обекта." },
      ],
    },
    switch: {
      eyebrow: "Започване",
      title: "Как започвате да продавате при нас",
      lead: "Цялата процедура я движи нашият екип. Вие подписвате.",
      steps: [
        { icon: FileSearch, title: "Изпращате ни данните на централата", text: "Мощност, точка на присъединяване и профил на производство. Изготвяме конкретна оферта по формулата, безплатно." },
        { icon: PenLine, title: "Подписвате дистанционно", text: "Договор на разбираем български, подписан онлайн. Нашият екип подава документите към мрежовия оператор и регистрира обекта в балансиращата ни група." },
        { icon: Repeat, title: "От 1-во число продавате при нас", text: "От датата на влизане в сила на договора обектът се регистрира към балансиращата група на NV Power и изкупуването започва при договорените условия. Смяната е чисто административна и изцяло дистанционна." },
      ],
    },
    invoice: {
      eyebrow: "Проверете сами",
      title: "Изпратете последното си отчитане и ще Ви покажем разликата",
      lead: `Прикачете последната фактура или отчет за произведена енергия и ще получите сравнителна оферта ${responseWithin.bg}, с конкретни числа, не с обещания.`,
    },
    faq: {
      eyebrow: "Въпроси",
      title: "Често задавани въпроси",
      items: [
        { q: "Ще спре ли производството ми при смяна на купувача?", a: "Не, нито за секунда. Смяната е чисто административна, енергията тръгва по същата мрежа, поддържана от същия мрежов оператор. Променя се само търговецът, който изкупува продукцията Ви." },
        { q: "Колко струва смяната и колко време отнема?", a: "Смяната е напълно безплатна, без такси, без депозити. Подаваме документите до 10-о число на месеца и от 1-во число на следващия вече продавате при нас. Цялата администрация поема нашият екип." },
        { q: "Какво е балансиране и защо го споменавате?", a: "Небалансът е разликата между заявените и действително измерените количества енергия за съответния период на сетълмент, и има цена, която някой плаща. Като член на балансиращата ни група отклоненията се компенсират взаимно между членовете, а ние като координатор отговаряме за уреждането им пред системния оператор. При NV Фиксиран план балансирането е включено в цената, без неочаквани изненади." },
        { q: "Как се формира цената, която получавам?", a: `По формулата на избрания план: борсовата цена на ${site.market.bg} за съответния период на сетълмент, минус договорения търговски компонент, например БНЕБ − 15 €/MWh при NV Фиксиран. ${site.pricingMethodology.bg} Получавате месечен отчет с пълна разбивка, без скрити удръжки.` },
        { q: "Мога ли да се откажа ако не съм доволен?", a: "Да, с предизвестието на избрания план – 1 месец при NV Фиксиран, 1 или 6 месеца при NV Standard. Без неустойки и без обвързващи клаузи." },
      ],
    },
  },
  en: {
    title: "Electricity buy-back for renewable producers | NV Power",
    description: `Sell your power on clear terms: NV Fixed (IBEX − €15/MWh), NV Standard or an individual offer above 1 MW. Balancing included on NV Fixed.`,
    hero: {
      h1: "Sell your power. On clear terms.",
      sub: "A licensed electricity trader. We buy the output of renewable producers, a transparent formula with balancing included on NV Fixed.",
      ctaPrimary: "Get a quote",
      ctaSecondary: "See the plans",
      checks: [responseBadge.en, "Balancing included on NV Fixed", "No deposits"],
    },
    plans: {
      eyebrow: "Plans",
      title: "Choose how you sell your power",
      lead: "Three plans with a clear price and a clear contract, and constant contact with our team throughout.",
      note: "balancing can be included",
      noticeLabel: "Notice period",
      items: [
        {
          icon: Zap,
          name: "NV Fixed",
          nameNote: "the trading component is fixed, the energy price is not",
          mechanism:
            "Purchase price: the IBEX day-ahead market, minus a fixed trading component of €15/MWh. The component is fixed, the energy price is not.",
          priceMain: "IBEX − €15/MWh",
          priceSub: site.market.en,
          term: "just 1 month's notice",
          features: [
            "Notice period: just 1 month, no long-term lock-in",
            "Fixed balancing",
            "Ongoing contact and support from our trading desk",
            "Ideal for small and mid-size renewable producers",
          ],
          cta: "Get an NV Fixed quote",
        },
        {
          icon: LineChart,
          badge: "Most popular",
          name: "NV Standard",
          nameNote: "the market price, with a lower component for a longer notice period",
          mechanism:
            "Purchase price: the IBEX day-ahead market, minus a trading component of €3 or €2/MWh, depending on the option you pick.",
          term: "two levels of flexibility",
          /* Two-component plan – the visitor picks a tier inside the card. */
          options: [
            {
              id: "flex",
              label: "Standard Flexible",
              formula: "IBEX − €3/MWh",
              notice: "1 month",
              hint: "Shorter term, more freedom",
            },
            {
              id: "long",
              label: "Standard Long-term",
              formula: "IBEX − €2/MWh",
              notice: "6 months",
              hint: "The best price in the standard plan",
            },
          ],
          features: [
            "Choose the level of flexibility that matches your horizon",
            "A lower balancing fee on a longer contract",
            "Full balancing-group management included",
          ],
          cta: "Choose NV Standard",
        },
        {
          icon: Building2,
          badge: "For large sites (over 1 MW)",
          name: "NV Individual",
          nameNote: "terms negotiated around the site's generation profile",
          mechanism:
            "Purchase price: negotiated, based on the plant's generation profile and the contract period.",
          priceMain: "Negotiated",
          priceSub: "based on your generation profile",
          term: "notice period set by contract",
          features: [
            "A tailored offer for producers with over 1 MW installed capacity",
            "Notice period: set individually in the contract",
            "Analysis of your generation profile before the offer",
            "A personal account manager and an individual trading strategy",
          ],
          cta: "Request an individual offer",
        },
      ],
      b2b: {
        badge: "For plants above 1 MW",
        title: "An individual offer for large renewable plants",
        text: "For producers above 1 MW we prepare tailored buy-back terms, built around the specific generation profile.",
        cta: "Request an individual offer",
        supplyNote: "Looking to buy electricity for a site of your own rather than sell it?",
        supplyCta: "See supply",
      },
    },
    compare: {
      eyebrow: "Comparison",
      title: "The plans side by side",
      methodology: site.pricingMethodology.en,
      lead: `Reference market: ${site.marketFull.en}. All trading components are stated in €/MWh. No asterisks, no small print, these are the terms.`,
      cols: ["Plan", "Formula", "Notice period", "Target group", "Key advantage"],
      rows: [
        { plan: "NV Fixed", formula: "IBEX − €15/MWh", notice: "1 month", target: "Small renewable plants", advantage: "Full freedom, one month's notice." },
        { plan: "NV Standard Flexible", formula: "IBEX − €3/MWh", notice: "1 month", target: "Mid-size renewables", advantage: "A balance of good price and a short commitment." },
        { plan: "NV Standard Long-term", formula: "IBEX − €2/MWh", notice: "6 months", target: "Established renewables", advantage: "Maximum return with the lowest balancing fee." },
        { plan: "NV Individual", formula: "Negotiated", notice: "Negotiated", target: "Sites over 1 MW", advantage: "Terms built around your site's profile." },
      ],
    },
    switch: {
      eyebrow: "Getting started",
      title: "How you start selling to us",
      lead: "We drive the whole procedure, all you do is sign.",
      steps: [
        { icon: FileSearch, title: "Send us your plant details", text: "Capacity, grid connection point and generation profile. We prepare a concrete offer on the formula. It's free." },
        { icon: PenLine, title: "Sign remotely", text: "A plain-language contract, signed online. We file the paperwork with the grid operator and add you to our balancing group." },
        { icon: Repeat, title: "From the 1st, you sell to us", text: "From the contract’s effective date the site is registered to the NV Power balancing group and buy-back starts on the agreed terms. The switch is purely administrative and fully remote." },
      ],
    },
    invoice: {
      eyebrow: "Check for yourself",
      title: "Send us your latest settlement, we'll show you the difference",
      lead: `Attach your latest invoice or generation report and you'll get a comparative offer ${responseWithin.en}, with real numbers, not promises.`,
    },
    faq: {
      eyebrow: "Questions",
      title: "Frequently asked questions",
      items: [
        { q: "Will my generation stop when I change buyer?", a: "No, not for a second. The change is purely administrative, the energy flows through the same grid, maintained by the same grid operator. Only the trader purchasing your output changes." },
        { q: "How much does switching cost and how long does it take?", a: "Switching is completely free, no fees, no deposits. We file the documents by the 10th of the month and from the 1st of the next month you are selling to us. We handle all the administration." },
        { q: "What is balancing and why do you mention it?", a: "An imbalance is the difference between the nominated and the actually metered quantities of energy for the relevant settlement period, and it has a price someone pays. As a member of our balancing group, members’ deviations offset each other, and as coordinator we handle settling them towards the system operator. On the NV Fixed plan, balancing is included in the price, with no surprises." },
        { q: "How is the price I receive calculated?", a: `By your plan formula: the ${site.market.en} price for the relevant settlement period, minus the agreed trading component, for example IBEX − €15/MWh on NV Fixed. ${site.pricingMethodology.en} You get a monthly report with a full breakdown and no hidden deductions.` },
        { q: "Can I leave if I am not happy?", a: "Yes, on your plan notice period – 1 month on NV Fixed, 1 or 6 months on NV Standard. No penalties, no lock-in clauses." },
      ],
    },
  },
}[locale];
---

<BaseLayout locale={locale} title={c.title} description={c.description} path="/tok/" jsonLd={[serviceLd]}>
  <!-- 1 ▸ HERO (dark band) -->
  <section class="bg-band">
    <div class="container-site py-16 text-center md:py-24">
      <h1 class="mx-auto max-w-3xl text-4xl font-bold text-white sm:text-5xl md:text-6xl md:leading-[1.05]">
        {c.hero.h1.split(".")[0]}.<br /><span class="text-[#6fd0da]">{c.hero.h1.split(".").slice(1).join(".").trim()}</span>
      </h1>
      <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-white/75 md:text-lg">{c.hero.sub}</p>

      {/* Plans lead: the tariff is what a producer is here to compare, so it
          takes first position and the filled style; the quote CTA follows. */}
      <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
        <a href="#planove" class="btn btn-primary !px-7 !py-4 text-base">
          {c.hero.ctaSecondary}
          <ArrowRight class="size-4" aria-hidden="true" />
        </a>
        <a href={r(locale, "oferta")} class="btn btn-ghost-band !px-7 !py-4 text-base">{c.hero.ctaPrimary}</a>
      </div>

      <ul class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2.5">
        {c.hero.checks.map((check) => (
          <li class="flex items-center gap-2 text-sm font-medium text-white/80">
            {check}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 2 ▸ PLANS -->
  <section id="planove" class="section container-site">
    <SectionHeading eyebrow={c.plans.eyebrow} title={c.plans.title} lead={c.plans.lead} />

    <p class="mx-auto mt-6 w-fit rounded-full bg-accent/10 px-5 py-2.5 text-sm font-semibold text-accent">
      {c.plans.note}
    </p>

    <!-- 3-up only from xl: at md the cards are ~160px wide, too narrow for the
         tier boxes and it forces the plan title onto two lines -->
    <div class="mt-12 grid gap-6 md:grid-cols-2 xl:grid-cols-3">
      {c.plans.items.map((plan, i) => (
        <article
          class:list={["card relative flex h-full flex-col gap-5 p-7 md:p-8", i === 1 && "border-accent ring-1 ring-accent"]}
        >
          {/* Not every plan carries a badge; without the guard an empty
              pill floats above the card. */}
          {"badge" in plan && plan.badge && (
            <span
              class:list={[
                "absolute -top-3.5 left-6 rounded-full px-3.5 py-1.5 text-xs font-bold",
                i === 1 ? "bg-accent text-accent-contrast" : "bg-accent/10 text-accent",
              ]}
            >
              {plan.badge}
            </span>
          )}

          <span class="mt-2 flex size-12 items-center justify-center rounded-xl bg-accent/10 text-accent">
            <plan.icon class="size-6" aria-hidden="true" />
          </span>
          {/* The name says „фиксиран"; only the trading component is, so the
              qualifier rides on the name where a scanner cannot miss it, and
              the sentence below carries the full mechanism. */}
          <div>
            <h3 class="text-xl font-bold text-body">
              {plan.name}
              {"options" in plan && plan.options && (
                <span class="text-xs font-medium text-muted"> ({plan.term})</span>
              )}
            </h3>
            <p class="mt-1 text-xs leading-snug font-medium text-accent">{plan.nameNote}</p>
          </div>

          <p class="-mt-1 text-[0.8rem] leading-snug text-muted">{plan.mechanism}</p>

          {!("options" in plan && plan.options) && (
            <p class="font-[family-name:var(--font-display)]">
              <span class:list={["font-bold text-accent", i === 1 ? "text-4xl" : "text-3xl"]}>{plan.priceMain}</span>
              <span class="mt-1 block text-sm font-bold text-muted">{plan.priceSub}</span>
              <span class="mt-1 block text-sm font-medium text-accent">{plan.term}</span>
            </p>
          )}

          {"options" in plan && plan.options && (
            <div class="grid grid-cols-2 gap-2.5">
              {plan.options.map((opt) => (
                <div class="flex flex-col rounded-xl border border-line bg-surface-alt p-3">
                  <p class="text-[11px] leading-tight font-bold tracking-wide text-accent uppercase">{opt.label}</p>
                  <!-- No nowrap: with the unit spelled out, "БНЕБ − 3 €/MWh" is 144px of
                       text in a 108px box at 375px. Letting it break at the space
                       puts the unit on its own line instead of clipping it. -->
                  <p class="mt-2 font-[family-name:var(--font-display)] text-base leading-tight font-bold text-accent">{opt.formula}</p>
                  <p class="mt-2 text-xs leading-snug font-semibold text-body">
                    {c.plans.noticeLabel}: <span class="whitespace-nowrap">{opt.notice}</span>
                  </p>
                  <p class="mt-1 text-[11px] leading-snug text-muted">{opt.hint}</p>
                </div>
              ))}
            </div>
          )}

          <ul class="list-disc space-y-2.5 pl-5 marker:text-accent">
            {plan.features.map((f) => (
              <li class="text-sm text-body">
                {f}
              </li>
            ))}
          </ul>

          <a href={r(locale, "oferta")} class:list={["btn mt-auto self-start", i === 1 ? "btn-primary" : "btn-outline"]}>
            {plan.cta}
            <ArrowRight class="size-4" aria-hidden="true" />
          </a>
        </article>
      ))}
    </div>

    <!-- B2B: supply and buy-back above 1 MW. Deliberately the loudest block on
         the page – it sits on the dark band surface the hero and CTA band use, so
         it separates hard from the white plan cards without new colours. -->
    <div
      class="mt-10 overflow-hidden rounded-2xl bg-band-deep p-8 shadow-[0_18px_50px_-18px_rgb(13_47_51/0.55)] ring-1 ring-accent/40 md:p-10"
    >
      <div class="flex flex-col gap-7 md:flex-row md:items-center md:justify-between md:gap-10">
        <div class="flex items-start gap-5">
          <span class="flex size-14 shrink-0 items-center justify-center rounded-2xl bg-accent text-accent-contrast">
            <Building2 class="size-7" aria-hidden="true" />
          </span>
          <div>
            <span
              class="inline-block rounded-full bg-accent px-3 py-1 font-[family-name:var(--font-display)] text-xs font-bold tracking-wide text-accent-contrast uppercase"
            >
              {c.plans.b2b.badge}
            </span>
            <h3 class="mt-3 font-[family-name:var(--font-display)] text-2xl font-bold text-white md:text-3xl">
              {c.plans.b2b.title}
            </h3>
            <p class="mt-3 max-w-2xl text-base leading-relaxed text-white/80">{c.plans.b2b.text}</p>
            {/* Buyers were previously served from inside this block; they now
                get a signpost to their own page instead of shared copy. */}
            <p class="mt-4 text-sm text-white/70">
              {c.plans.b2b.supplyNote}{" "}
              <a href={r(locale, "dostavka")} class="font-semibold text-white underline decoration-2 underline-offset-4">
                {c.plans.b2b.supplyCta}
              </a>
            </p>
          </div>
        </div>
        <a href={r(locale, "kontakti")} class="btn btn-primary shrink-0 self-start !px-8 !py-4 text-base md:self-auto">
          {c.plans.b2b.cta}
          <ArrowRight class="size-4" aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <!-- 3 ▸ COMPARISON TABLE -->
  <section class="bg-surface-alt">
    <div class="container-site section">
      <SectionHeading eyebrow={c.compare.eyebrow} title={c.compare.title} lead={c.compare.lead} />

      <div class="card mt-10 overflow-x-auto">
        <table class="w-full min-w-[48rem] border-collapse text-sm">
          <thead>
            <tr class="bg-band text-left text-white">
              {c.compare.cols.map((col) => (
                <th scope="col" class="px-5 py-4 font-[family-name:var(--font-display)] font-bold md:px-6">{col}</th>
              ))}
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {c.compare.rows.map((row) => (
              <tr class="odd:bg-surface even:bg-surface-alt/60">
                <th scope="row" class="px-5 py-3.5 text-left font-semibold text-body md:px-6">{row.plan}</th>
                <td class="px-5 py-3.5 font-[family-name:var(--font-display)] font-bold text-accent md:px-6">{row.formula}</td>
                <td class="px-5 py-3.5 text-muted md:px-6">{row.notice}</td>
                <td class="px-5 py-3.5 text-muted md:px-6">{row.target}</td>
                <td class="px-5 py-3.5 text-muted md:px-6">{row.advantage}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      {/* A published formula is the headline, not the mechanism: settlement and
          balancing rules are contractual. Said once, and outside the table's
          scroll container, where it used to inherit no padding and scroll
          sideways out of view. */}
      <p class="mt-5 max-w-3xl text-sm leading-relaxed text-muted">{c.compare.methodology}</p>
    </div>
  </section>

  <!-- 4 ▸ HOW TO SWITCH -->
  <section class="section container-site">
    <SectionHeading eyebrow={c.switch.eyebrow} title={c.switch.title} lead={c.switch.lead} />
    <ol class="mt-12 grid gap-6 md:grid-cols-3">
      {c.switch.steps.map((s, i) => (
        <li class="card relative p-7">
          <span class="absolute top-6 right-6 font-[family-name:var(--font-display)] text-5xl font-bold text-line">{String(i + 1).padStart(2, "0")}</span>
          <span class="flex size-12 items-center justify-center rounded-xl bg-accent/10 text-accent"><s.icon class="size-6" aria-hidden="true" /></span>
          <h3 class="mt-4 text-lg font-bold text-body">{s.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{s.text}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- 5 ▸ INVOICE UPLOAD (dark band) -->
  {
    /* Hidden until a form endpoint exists: asking for an invoice and then
       dropping it is worse than not asking. Returns automatically. */
    CAN_ACCEPT_UPLOADS && (
  <section class="bg-band">
    <div class="container-site section">
      <SectionHeading eyebrow={c.invoice.eyebrow} title={c.invoice.title} lead={c.invoice.lead} on="band" />
      <ul class="mt-7 flex flex-wrap items-center justify-center gap-x-7 gap-y-2.5">
        <li class="flex items-center gap-2 text-sm font-medium text-white/85"><Clock class="size-4 text-[#6fd0da]" aria-hidden="true" /> {locale === "bg" ? responseBadge.bg : responseBadge.en}</li>
        <li class="flex items-center gap-2 text-sm font-medium text-white/85"><BadgePercent class="size-4 text-[#6fd0da]" aria-hidden="true" /> {locale === "bg" ? "Без скрити такси" : "No hidden fees"}</li>
        <li class="flex items-center gap-2 text-sm font-medium text-white/85"><ShieldCheck class="size-4 text-[#6fd0da]" aria-hidden="true" /> {locale === "bg" ? "Без ангажимент" : "No commitment"}</li>
      </ul>
      <div class="mx-auto mt-10 max-w-2xl">
        <InvoiceUpload locale={locale} client:visible />
      </div>
    </div>
  </section>
    )
  }

  <!-- 6 ▸ FAQ -->
  <section class="section container-site">
    <SectionHeading eyebrow={c.faq.eyebrow} title={c.faq.title} />
    <div class="mx-auto mt-10 max-w-3xl">
      <FaqAccordion items={c.faq.items} />
    </div>
  </section>

  <!-- 7 ▸ FINAL CTA BAND -->
  <CtaBand locale={locale} variant="producer" />
</BaseLayout>

