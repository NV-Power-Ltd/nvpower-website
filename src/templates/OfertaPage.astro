---
import { ShieldCheck, Clock, BadgePercent, Phone, Mail, ArrowRight } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import OfferWizard from "../islands/OfferWizard";
import type { Locale } from "../config/site";
import { site, OFFER_WIZARD_READY, responseBadge, responseWithin } from "../config/site";
import { r } from "../i18n/ui";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const c = {
  bg: {
    title: "Вземете оферта, NV Power",
    description: `Заявете оферта за изкупуване на ток, доставка на електроенергия или соларна система. Отговор от консултант ${responseWithin.bg}, без ангажимент.`,
    h1: "Вземете своята оферта",
    sub: "Отговори на няколко въпроса за обекта си и ще подготвим конкретни числа, цена, икономия и срок на откупуване. Отнема около 90 секунди.",
    /* Used instead of `sub` while the wizard is hidden: it must not promise a
       questionnaire that is not on the page. */
    subOffline:
      "Обадете ни се или ни пишете и ще подготвим конкретни числа за Вашия обект: цена, икономия и срок на откупуване.",
    badges: [
      { icon: Clock, text: responseBadge.bg },
      { icon: BadgePercent, text: "Без скрити такси" },
      { icon: ShieldCheck, text: "Без ангажимент и без депозити" },
    ],
    /* Shown while the wizard is off. It must not mention a questionnaire: there
       isn't one, and promising it is what made this flow a dead end. */
    offline: {
      title: "За какво Ви е офертата?",
      text: `Изберете направлението и попълнете кратката форма, или ни се обадете. Отговаряме ${responseWithin.bg}.`,
      routes: [
        { label: "Изкупуване на ток от ВЕИ централа", hint: "мощност, точка на присъединяване, профил на производство", interest: 0 },
        { label: "Доставка на електроенергия", hint: "за консуматори над 1 MW, по товаров профил", interest: 1 },
        { label: "Соларна система за дома", hint: "покрив, потребление, батерия", interest: 2 },
        { label: "Соларна система за бизнеса", hint: "обект, мощност, финансиране", interest: 3 },
      ],
      orCall: "Или ни се обадете направо:",
      callCta: "Обадете се",
      mailCta: "Пишете ни",
    },
  },
  en: {
    title: "Get a quote, NV Power",
    description: `Request a quote for power buy-back, electricity supply or a solar system. A consultant replies ${responseWithin.en}, no commitment.`,
    h1: "Get your quote",
    sub: "Answer a few questions about your site and we'll prepare real numbers, price, savings and payback period. Takes about 90 seconds.",
    subOffline:
      "Call or email us and we'll prepare real numbers for your site, price, savings and payback period.",
    badges: [
      { icon: Clock, text: responseBadge.en },
      { icon: BadgePercent, text: "No hidden fees" },
      { icon: ShieldCheck, text: "No commitment, no deposits" },
    ],
    offline: {
      title: "What do you need a quote for?",
      text: `Pick your area and fill in the short form, or just call us. We reply ${responseWithin.en}.`,
      routes: [
        { label: "Buy-back from a renewable plant", hint: "capacity, connection point, generation profile", interest: 0 },
        { label: "Electricity supply", hint: "for consumers above 1 MW, priced off a load profile", interest: 1 },
        { label: "A solar system for a home", hint: "roof, consumption, battery", interest: 2 },
        { label: "A solar system for a business", hint: "site, capacity, financing", interest: 3 },
      ],
      orCall: "Or call us directly:",
      callCta: "Call us",
      mailCta: "Email us",
    },
  },
}[locale];
---

<BaseLayout locale={locale} title={c.title} description={c.description} path="/oferta/">
  <section class="bg-surface-alt border-b border-line">
    <div class="container-site pt-12 pb-28 text-center md:pt-16">
      <h1 class="text-3xl font-bold text-body md:text-5xl">{c.h1}</h1>
      <p class="mx-auto mt-4 max-w-xl text-muted md:text-lg">{OFFER_WIZARD_READY ? c.sub : c.subOffline}</p>
      <ul class="mt-6 flex flex-wrap items-center justify-center gap-x-7 gap-y-2.5">
        {c.badges.map((b) => (
          <li class="flex items-center gap-2 text-sm font-medium text-body">
            <b.icon class="size-4 text-accent" aria-hidden="true" />
            {b.text}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- The wizard, or the honest alternative while it is being reworked. The
       page, its route and every inbound quote link stay put either
       way; only what sits in this slot changes. -->
  <section class="container-site -mt-20 pb-20 md:pb-24">
    {
      OFFER_WIZARD_READY ? (
        <OfferWizard locale={locale} client:load />
      ) : (
        <div class="card mx-auto max-w-2xl p-7 md:p-9">
          <h2 class="text-center text-xl font-bold text-body md:text-2xl">{c.offline.title}</h2>
          <p class="mx-auto mt-3 max-w-lg text-center leading-relaxed text-muted">{c.offline.text}</p>

          <!-- Each route lands on the contact form with its own service already
               selected, so the enquiry arrives labelled. -->
          <ul class="mt-7 flex flex-col gap-3">
            {c.offline.routes.map((route) => (
              <li>
                <a
                  href={`${r(locale, "kontakti")}?interest=${route.interest}#zapitvane`}
                  class="card group flex items-center justify-between gap-4 px-5 py-4 transition-all hover:-translate-y-0.5 hover:border-accent"
                >
                  <span>
                    <span class="block font-[family-name:var(--font-display)] font-bold text-body group-hover:text-accent">
                      {route.label}
                    </span>
                    <span class="mt-0.5 block text-sm text-muted">{route.hint}</span>
                  </span>
                  <ArrowRight class="size-4 shrink-0 text-accent" aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>

          <p class="mt-7 text-center text-sm font-semibold text-muted">{c.offline.orCall}</p>
          <div class="mt-3 flex flex-col items-stretch justify-center gap-3 sm:flex-row sm:items-center">
            <a href={`tel:${site.phoneHref}`} class="btn btn-primary !px-7 !py-4 text-base">
              <Phone class="size-4" aria-hidden="true" />
              {site.phone}
            </a>
            <a href={`mailto:${site.email}`} class="btn btn-outline !px-7 !py-4 text-base">
              <Mail class="size-4" aria-hidden="true" />
              {c.offline.mailCta}
            </a>
          </div>
        </div>
      )
    }
  </section>
</BaseLayout>
